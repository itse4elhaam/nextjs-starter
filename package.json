{
  "name": "nextjs-starter",
  "version": "0.1.0",
  "private": true,
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version"
    ]
  },
  "scripts": {
    "dev": "npx env-cmd -f \".env\" next dev --turbopack",
    "build": "bun run validate:env && next build",
    "start": "npx env-cmd -f \".env\" next start",
    "lint": "biome check .",
    "lint:fix": "biome lint --write",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:drop": "drizzle-kit drop",
    "prepare": "husky",
    "type-check": "bunx jiti scripts/write-next-route-types.ts && bunx tsc --noEmit",
    "validate": "bun run type-check && bun run lint",
    "validate:env": "bunx jiti scripts/validate-env.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "@sentry/nextjs": "^8.48.0",
    "@t3-oss/env-core": "^0.13.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "jiti": "^2.4.2",
    "lucide-react": "^0.511.0",
    "neverthrow": "^6.2.2",
    "next": "16.1.6",
    "postgres": "^3.4.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.0",
    "web-vitals": "^5.3.0",
    "zod": "^3.25.36"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "19.2.6",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "^4.1.0",
    "drizzle-kit": "^0.31.4",
    "husky": "^9.1.7",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.2",
    "typescript": "^5",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "@types/react": "19.2.6",
    "@types/react-dom": "19.2.3"
  }
}
