[ -n "$CI" ] && exit 0

PROTECTED="main|dev"
BRANCH=$(git symbolic-ref HEAD --short 2>/dev/null)

if echo "$BRANCH" | grep -qE "^($PROTECTED)$"; then
  if [ "$ALLOW_PROTECTED_PUSH" != "true" ]; then
    echo ""
    echo "  Direct pushes to '$BRANCH' are not allowed."
    echo "  Create a Pull Request instead:"
    echo ""
    echo "    feature/*  ->  PR  ->  dev  ->  PR  ->  main"
    echo ""
    echo "  Emergency override:"
    echo "    ALLOW_PROTECTED_PUSH=true git push"
    echo ""
    exit 1
  fi
fi

if git diff --cached --diff-filter=ACMR --name-only -z | xargs -0 -r grep -lP '<<<<<<< |=======|>>>>>>>' --; then
  echo ""
  echo "  Unresolved merge conflict markers found. Aborting push."
  echo ""
  exit 1
fi

bun run lint
bun run type-check
